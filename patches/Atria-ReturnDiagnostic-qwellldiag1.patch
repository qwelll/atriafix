diff --git a/src/Manager/qwelllAtriaReturnDiagnostic.m b/src/Manager/qwelllAtriaReturnDiagnostic.m
new file mode 100644
index 0000000..ed2aae5
--- /dev/null
+++ b/src/Manager/qwelllAtriaReturnDiagnostic.m
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Read-only observations: no animation, scale, layout or visibility writes.
+#import "../Hooks/qwelllAtriaReturnDiagnostic.h"
+#import <QuartzCore/QuartzCore.h>
+#import <objc/runtime.h>
+#import <objc/message.h>
+#import <substrate.h>
+#import <math.h>
+
+static NSMutableArray *qwelll_atriadiag_ring;
+static dispatch_queue_t qwelll_atriadiag_io;
+static BOOL qwelll_atriadiag_pending, qwelll_atriadiag_reading;
+static NSUInteger qwelll_atriadiag_sequence, qwelll_atriadiag_nextID, qwelll_atriadiag_dropped;
+static char qwelll_atriadiag_idKey;
+static NSString *qwelll_atriadiag_system;
+
+static BOOL qwelll_atriadiag_signature(Class cls, SEL sel, const char *ret, const char *arg) {
+    Method m = class_getInstanceMethod(cls, sel);
+    if (!m || method_getNumberOfArguments(m) != (arg ? 3u : 2u)) return NO;
+    char *r = method_copyReturnType(m);
+    BOOL ok = r && strcmp(r, ret) == 0;
+    free(r);
+    if (arg) { char *a = method_copyArgumentType(m, 2); ok = ok && a && strcmp(a, arg) == 0; free(a); }
+    return ok;
+}
+static id qwelll_atriadiag_object(id obj, const char *name) {
+    SEL s = sel_registerName(name);
+    if (!obj || !qwelll_atriadiag_signature(object_getClass(obj), s, "@", NULL)) return nil;
+    return ((id (*)(id, SEL))objc_msgSend)(obj, s);
+}
+static id qwelll_atriadiag_scale(id obj, const char *name) {
+    SEL s = sel_registerName(name);
+    if (!qwelll_atriadiag_signature(object_getClass(obj), s, @encode(CGFloat), NULL)) return [NSNull null];
+    double x = ((CGFloat (*)(id, SEL))objc_msgSend)(obj, s);
+    return isfinite(x) ? @(x) : (id)[NSNull null];
+}
+static NSArray *qwelll_atriadiag_matrix(CATransform3D t) {
+    const CGFloat a[] = {t.m11,t.m12,t.m13,t.m14,t.m21,t.m22,t.m23,t.m24,t.m31,t.m32,t.m33,t.m34,t.m41,t.m42,t.m43,t.m44};
+    NSMutableArray *r = [NSMutableArray arrayWithCapacity:16];
+    for (int i=0;i<16;i++) [r addObject:isfinite(a[i]) ? (id)@(a[i]) : [NSNull null]];
+    return r;
+}
+static NSDictionary *qwelll_atriadiag_layer(CALayer *layer, BOOL sublayer) {
+    if (!layer) return @{};
+    CALayer *p = (CALayer *)layer.presentationLayer;
+    return @{ @"model": qwelll_atriadiag_matrix(sublayer ? layer.sublayerTransform : layer.transform),
+              @"presentation": p ? (id)qwelll_atriadiag_matrix(sublayer ? p.sublayerTransform : p.transform) : [NSNull null] };
+}
+static void qwelll_atriadiag_write(NSArray *batch, NSUInteger dropped) {
+    @autoreleasepool {
+        NSMutableData *data = [NSMutableData data];
+        if (dropped) {
+            NSData *d = [NSJSONSerialization dataWithJSONObject:@{@"event":@"ring_overwrite",@"count":@(dropped)} options:0 error:NULL];
+            [data appendData:d]; [data appendBytes:"\n" length:1];
+        }
+        for (NSDictionary *row in batch) {
+            NSData *d = [NSJSONSerialization dataWithJSONObject:row options:0 error:NULL];
+            if (d) { [data appendData:d]; [data appendBytes:"\n" length:1]; }
+        }
+        NSArray *paths = @[[NSHomeDirectory() stringByAppendingPathComponent:@"Documents/AtriaReturnDiagnostic.log"], @"/tmp/AtriaReturnDiagnostic.log"];
+        for (NSString *path in paths) {
+            NSFileManager *fm = [NSFileManager defaultManager];
+            [fm createDirectoryAtPath:path.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:NULL];
+            unsigned long long size = [[fm attributesOfItemAtPath:path error:NULL][NSFileSize] unsignedLongLongValue];
+            if (size > 2*1024*1024) {
+                [fm removeItemAtPath:[path stringByAppendingString:@".1"] error:NULL];
+                [fm moveItemAtPath:path toPath:[path stringByAppendingString:@".1"] error:NULL];
+            }
+            if (![fm fileExistsAtPath:path]) [fm createFileAtPath:path contents:nil attributes:nil];
+            NSFileHandle *f = [NSFileHandle fileHandleForWritingAtPath:path];
+            if (!f) continue;
+            @try { [f seekToEndOfFile]; [f writeData:data]; [f closeFile]; return; }
+            @catch (__unused NSException *e) { @try { [f closeFile]; } @catch (__unused NSException *ignored) {} }
+        }
+    }
+}
+static void qwelll_atriadiag_enqueue(NSDictionary *row) {
+    if (!qwelll_atriadiag_ring) qwelll_atriadiag_ring = [NSMutableArray arrayWithCapacity:480];
+    if (qwelll_atriadiag_ring.count == 480) { [qwelll_atriadiag_ring removeObjectAtIndex:0]; qwelll_atriadiag_dropped++; }
+    [qwelll_atriadiag_ring addObject:row];
+    if (qwelll_atriadiag_pending) return;
+    qwelll_atriadiag_pending = YES;
+    // Event-driven coalescing only, never refresh any scale or view on a timer.
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2*NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        NSArray *batch = [qwelll_atriadiag_ring copy];
+        NSUInteger dropped = qwelll_atriadiag_dropped;
+        [qwelll_atriadiag_ring removeAllObjects]; qwelll_atriadiag_dropped = 0;
+        // Keep pending until I/O finishes: slow storage cannot build an unlimited queue.
+        dispatch_async(qwelll_atriadiag_io, ^{
+            qwelll_atriadiag_write(batch, dropped);
+            dispatch_async(dispatch_get_main_queue(), ^{
+                qwelll_atriadiag_pending = NO;
+                if (qwelll_atriadiag_ring.count) qwelll_atriadiag_enqueue(@{@"event":@"io_merge",@"t":@([NSDate timeIntervalSinceReferenceDate])});
+            });
+        });
+    });
+}
+void qwelll_atriadiag_record(UIView *view, const char *event, double argument) {
+    if (![NSThread isMainThread] || qwelll_atriadiag_reading || !qwelll_atriadiag_io) return;
+    qwelll_atriadiag_reading = YES;
+    @try {
+        id icon = qwelll_atriadiag_object(view, "icon");
+        Class app = objc_getClass("SBApplicationIcon");
+        if (!app || ![icon isKindOfClass:app]) return;
+        id loc = qwelll_atriadiag_object(view, "location");
+        if (![loc isKindOfClass:[NSString class]]) return;
+        // Never log arbitrary location strings; emit only these public enum constants.
+        static NSSet *locations;
+        static dispatch_once_t locationsOnce;
+        dispatch_once(&locationsOnce, ^{ locations = [NSSet setWithObjects:@"SBIconLocationRoot",@"SBIconLocationRootWithWidgets",@"SBIconLocationDock",@"SBIconLocationFloatingDock",@"SBIconLocationFloatingDockSuggestions",nil]; });
+        if (![locations containsObject:loc]) return;
+        NSNumber *identifier = objc_getAssociatedObject(view, &qwelll_atriadiag_idKey);
+        if (!identifier) { identifier = @(++qwelll_atriadiag_nextID); objc_setAssociatedObject(view, &qwelll_atriadiag_idKey, identifier, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
+        NSMutableDictionary *row = [@{@"seq":@(++qwelll_atriadiag_sequence),@"viewID":identifier,@"t":@([NSDate timeIntervalSinceReferenceDate]),@"uptime":@(CACurrentMediaTime()),@"os":qwelll_atriadiag_system,@"event":@(event),@"arg":isfinite(argument)?(id)@(argument):[NSNull null],@"location":loc,@"superclass":view.superview?NSStringFromClass(object_getClass(view.superview)):@"nil",@"iconContentScale":qwelll_atriadiag_scale(view,"iconContentScale"),@"effectiveIconContentScale":qwelll_atriadiag_scale(view,"effectiveIconContentScale"),@"iconLayerSublayer":qwelll_atriadiag_layer(view.layer,YES),@"parentLayerSublayer":qwelll_atriadiag_layer(view.layer.superlayer,YES)} mutableCopy];
+        UIView *container = qwelll_atriadiag_object(view,"contentContainerView");
+        if ([container isKindOfClass:[UIView class]]) row[@"contentContainer"] = qwelll_atriadiag_layer(container.layer,NO);
+        // Read exactly one existing object ivar, never call a lazy image getter or walk subviews.
+        Ivar iv = class_getInstanceVariable(object_getClass(view),"_iconImageView");
+        if (iv && ivar_getTypeEncoding(iv)[0]=='@') {
+            id image = object_getIvar(view,iv);
+            if ([image isKindOfClass:[UIView class]]) row[@"existingIconImage"] = qwelll_atriadiag_layer(((UIView *)image).layer,NO);
+        }
+        qwelll_atriadiag_enqueue(row);
+    } @catch (__unused NSException *e) { /* No description: exception text can contain app data. */ }
+    @finally { qwelll_atriadiag_reading = NO; }
+}
+static void (*qwelll_atriadiag_origApply)(id,SEL,CGFloat);
+static void (*qwelll_atriadiag_origUpdate)(id,SEL);
+static void (*qwelll_atriadiag_origHidden)(id,SEL,BOOL);
+static void qwelll_atriadiag_apply(id self,SEL cmd,CGFloat x) {
+    qwelll_atriadiag_record(self,"apply.before",x); qwelll_atriadiag_origApply(self,cmd,x); qwelll_atriadiag_record(self,"apply.after",x);
+}
+static void qwelll_atriadiag_update(id self,SEL cmd) {
+    qwelll_atriadiag_record(self,"updateScale.before",NAN); qwelll_atriadiag_origUpdate(self,cmd); qwelll_atriadiag_record(self,"updateScale.after",NAN);
+}
+static void qwelll_atriadiag_hidden(id self,SEL cmd,BOOL x) {
+    qwelll_atriadiag_record(self,"hidden.before",x); qwelll_atriadiag_origHidden(self,cmd,x); qwelll_atriadiag_record(self,"hidden.after",x);
+}
+void qwelll_atriadiag_start(void) {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        qwelll_atriadiag_io = dispatch_queue_create("com.qwelll.atria.return-diagnostic.io", DISPATCH_QUEUE_SERIAL);
+        qwelll_atriadiag_system = [UIDevice currentDevice].systemVersion;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            Class cls = objc_getClass("SBIconView");
+            NSMutableArray *checks = [NSMutableArray array];
+            const char *names[] = {"_applyIconContentScale:","_updateIconContentScale","setHidden:"};
+            const char *args[] = {@encode(CGFloat),NULL,@encode(BOOL)};
+            IMP hooks[] = {(IMP)qwelll_atriadiag_apply,(IMP)qwelll_atriadiag_update,(IMP)qwelll_atriadiag_hidden};
+            IMP *originals[] = {(IMP *)&qwelll_atriadiag_origApply,(IMP *)&qwelll_atriadiag_origUpdate,(IMP *)&qwelll_atriadiag_origHidden};
+            for (int i=0;i<3;i++) {
+                SEL sel = sel_registerName(names[i]);
+                BOOL valid = qwelll_atriadiag_signature(cls,sel,"v",args[i]);
+                Method m = class_getInstanceMethod(cls,sel);
+                [checks addObject:@{@"selector":@(names[i]),@"enabled":@(valid),@"encoding":m ? @(method_getTypeEncoding(m)) : @"absent"}];
+                if (valid) MSHookMessageEx(cls,sel,hooks[i],originals[i]);
+            }
+            qwelll_atriadiag_enqueue(@{@"event":@"LOAD qwellldiag1",@"os":qwelll_atriadiag_system,@"t":@([NSDate timeIntervalSinceReferenceDate]),@"runtimeChecks":checks,@"ringCapacity":@480});
+        });
+    });
+}
