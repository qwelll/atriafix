+// iOS 17 source patch: qwelllAtriaReturnScaleFix.
+// Keep page identity only while the original list still owns this exact icon.
+static BOOL qwelllAtriaReturnScaleFixEnabled(void) {
+    NSOperatingSystemVersion v = [NSProcessInfo processInfo].operatingSystemVersion;
+    return v.majorVersion == 17;
+}
+
+static BOOL qwelllAtriaReturnScaleFixIsRoot(SBIconView *view) {
+    if(IconIsInRoot(view)) return YES;
+    // Do not reinterpret explicit Dock, folder, library or other locations.
+    if(view.location.length || !view.icon) return NO;
+    SBIconListView *list = view._atriaLastIconListView;
+    if(!list || !IconListIsRoot(list)) return NO;
+    return [[list icons] indexOfObjectIdenticalTo:view.icon] != NSNotFound;
+}
