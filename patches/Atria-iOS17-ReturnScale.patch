 - (void)_updateIconImageViewAnimated:(BOOL)arg1 {
-	%orig(arg1);
-	[self _atriaUpdateIconContentScale];
+    if(qwelllAtriaReturnScaleFixEnabled() && qwelllAtriaReturnScaleFixIsRoot(self)
+       && ![ARIEditManager sharedInstance].isEditing) {
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        %orig(arg1);
+        [self _atriaUpdateIconContentScale];
+        [CATransaction commit];
+        return;
+    }
+    %orig(arg1);
+    [self _atriaUpdateIconContentScale];
 }
 
 - (void)setIconContentScale:(CGFloat)scale {
-	%orig(scale);
-	[self _atriaUpdateIconContentScale];
+    if(qwelllAtriaReturnScaleFixEnabled() && qwelllAtriaReturnScaleFixIsRoot(self)
+       && ![ARIEditManager sharedInstance].isEditing) {
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        %orig(scale);
+        [self _atriaUpdateIconContentScale];
+        [CATransaction commit];
+        return;
+    }
+    %orig(scale);
+    [self _atriaUpdateIconContentScale];
+}
+
+// A layout pass may rewrite layer state without invoking either setter above.
+// Reapply in the same synchronous pass, never on a timer or the next frame.
+- (void)layoutSubviews {
